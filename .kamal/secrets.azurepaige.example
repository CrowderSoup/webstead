# Copy to .kamal/secrets.azurepaige and fill in real values.
# .kamal/secrets.azurepaige is gitignored — never commit it.
# Used for `kamal deploy -d azurepaige` (azurepaige.art, deployed from main).

SECRET_KEY=
DB_PASS=   # crowder-cloud cluster (doadmin) password, same as blog's
AWS_SECRET_ACCESS_KEY=   # DO Spaces secret for the azurepaige-art-scoped key (DO801LCF6YU9ZGX9FK6Q)
FIELD_ENCRYPTION_KEY=   # Fernet key - unique to this destination, do not reuse blog's
AKISMET_API_KEY=
TURNSTILE_SECRET_KEY=
CACHE_URL=redis://vtodo-redis:6379/6
CELERY_BROKER_URL=redis://vtodo-redis:6379/5
CELERY_RESULT_BACKEND=redis://vtodo-redis:6379/7
KAMAL_REGISTRY_PASSWORD=   # GitHub PAT with write:packages scope
